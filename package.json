{
    "name": "record",
    "version": "4.3.1",
    "private": true,
    "type": "module",
    "description": "A REPLACED-inspired terminal theme for Discord",
    "homepage": "https://leriart.github.io/ReCord/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leriart/ReCord.git"
    },
    "license": "Apache-2.0",
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "node scripts/check.mjs && node scripts/build.mjs --check",
        "icons": "python3 scripts/generate-icons.py && python3 scripts/generate-icon-css.py",
        "sounds": "python3 scripts/generate-sounds.py",
        "serve": "python3 -m http.server 8123"
    },
    "devDependencies": {
        "css-tree": "^3.2.1"
    }
}
